# FILG environment — copy to .env for local dev, or set these in the Render dashboard.
# Free-tier launch needs ONLY ANTHROPIC_API_KEY. Everything else is optional / has a default.

# ── Engine (required for real runs) ──────────────────────────────────────────
ANTHROPIC_API_KEY=            # your Anthropic key. Unset + FILG_MOCK=1 → canned results, no spend.
FILG_MOCK=                    # "1" → mock mode (no API calls, no auth, no billing). Dev/frontend only.

# ── Cost guardrails (have defaults; override to taste) ───────────────────────
FILG_FREE_RUNS=1             # free runs per user (email)
FILG_DAILY_BUDGET=5          # global $/day kill switch — trips for everyone, even paid
FILG_PAID_EMAILS=            # comma-sep manual comp allowlist (real paid status comes from Stripe)
FILG_DB=                     # sqlite path; on Render → /var/data/filg.db (persistent disk)

# ── Auth (Supabase) — leave blank for free-tier-only ─────────────────────────
SUPABASE_URL=                # https://xxxx.supabase.co   (Settings → API)
SUPABASE_ANON_KEY=           # publishable anon key       (frontend)
SUPABASE_JWT_SECRET=         # JWT secret — verifies user tokens server-side (keep secret)

# ── Billing (Stripe) — leave blank until you're ready to charge ──────────────
STRIPE_SECRET_KEY=           # sk_live_… / sk_test_…
STRIPE_PRICE_ID=             # price_… for the $39/mo recurring price
STRIPE_WEBHOOK_SECRET=       # whsec_… for POST /api/stripe/webhook
FILG_PUBLIC_URL=https://fuckitletsgo.ai   # base url for Stripe checkout success/cancel redirects
